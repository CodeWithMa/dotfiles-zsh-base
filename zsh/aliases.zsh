#!/bin/zsh

# shortcuts
alias clr='clear'
alias df='df -h'
alias en='LANG=en_US.UTF-8'
alias g='git'
alias ip='ip -c=auto'
alias v='nvim'

# My ls -lah / eza
alias l='eza -la --group-directories-first --git'

# bat instead of cat no Pager and no linenumbers
alias cat='bat -p -P'

# prettyping instead of ping
alias ping='prettyping'
